# Docker Compose MySQL credentials. Replace placeholders for local use.
MYSQL_DATABASE=service_graph
MYSQL_USER=service_graph
MYSQL_PASSWORD=replace-me
MYSQL_ROOT_PASSWORD=replace-me
MYSQL_PORT=3307
CAIRN_TEST_MYSQL_PORT=13307
CAIRN_TEST_DATABASE_URL=mysql://cairn_test:cairn_test_only@localhost:13307/cairn_test

# Host-run Nuxt and Drizzle CLI use localhost. Compose overrides the host to "mysql".
DATABASE_URL=mysql://service_graph:replace-me@localhost:3307/service_graph
OTEL_COLLECTOR_URL=http://host.docker.internal:4318
PROJECT_ID=local
PORT=3002
# Authentication is enabled by default. Set unique credentials for each deployment.
AUTH_ENABLED=true
AUTH_USERNAME=operator
AUTH_PASSWORD=replace-with-a-strong-password
# Generate with: openssl rand -hex 32
AUTH_SESSION_SECRET=
OUTBOUND_REQUEST_TIMEOUT_MS=10000
TELEMETRY_QUIET_MS=1500
TELEMETRY_MAX_WAIT_MS=10000

# OpenTelemetry ingestion authentication token.
OTEL_INGEST_TOKEN=replace-me
ADMINER_PORT=8889
# SonarQube analysis token. Keep secret values in .sonar.env.
SONARQUBE_TOKEN=replace-me
