OTEL_COLLECTOR_URL=http://host.docker.internal:4318
PROJECT_ID=local
PORT=3004
# Optional for host-run development; Compose uses /app/data.
CAIRN_DATA_DIR=data

# Authentication is enabled by default. Set unique credentials for each deployment.
AUTH_ENABLED=true
AUTH_USERNAME=operator
AUTH_PASSWORD=replace-with-a-strong-password
# Generate with: openssl rand -hex 32
AUTH_SESSION_SECRET=
OUTBOUND_REQUEST_TIMEOUT_MS=10000
TELEMETRY_QUIET_MS=5000
TELEMETRY_MAX_WAIT_MS=15000
TELEMETRY_RETENTION_DAYS=365
OTLP_MAX_COMPRESSED_BYTES=4194304
OTLP_MAX_DECOMPRESSED_BYTES=16777216
TELEMETRY_MAX_PENDING_RECORDS=10000
TELEMETRY_MAX_PENDING_BYTES=33554432
TELEMETRY_BATCH_SIZE=100

PROTO_STORAGE_DRIVER=fs
PROTO_STORAGE_FS_BASE=/app/data/protos
PROTO_STORAGE_S3_ENDPOINT=
PROTO_STORAGE_S3_REGION=
PROTO_STORAGE_S3_BUCKET=
PROTO_STORAGE_S3_ACCESS_KEY_ID=
PROTO_STORAGE_S3_SECRET_ACCESS_KEY=
# Optional CA download. Both URL and expected SHA-256 are required together.
CA_CERT_URL=
CA_CERT_SHA256=
