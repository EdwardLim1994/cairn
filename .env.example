# Docker Compose MySQL credentials. Replace placeholders for local use.
MYSQL_DATABASE=service_graph
MYSQL_USER=service_graph
MYSQL_PASSWORD=replace-me
MYSQL_ROOT_PASSWORD=replace-me
MYSQL_PORT=3309
CAIRN_TEST_MYSQL_PORT=13309
CAIRN_TEST_DATABASE_URL=mysql://cairn_test:cairn_test_only@localhost:13309/cairn_test

# Host-run Nuxt and Drizzle CLI use localhost. Compose overrides the host to "mysql".
DATABASE_URL=mysql://service_graph:replace-me@localhost:3309/service_graph
OTEL_COLLECTOR_URL=http://host.docker.internal:4318
PROJECT_ID=local
PORT=3004
# Authentication is enabled by default. Set unique credentials for each deployment.
AUTH_ENABLED=true
AUTH_USERNAME=operator
AUTH_PASSWORD=replace-with-a-strong-password
# Generate with: openssl rand -hex 32
AUTH_SESSION_SECRET=
OUTBOUND_REQUEST_TIMEOUT_MS=10000
TELEMETRY_QUIET_MS=5000
TELEMETRY_MAX_WAIT_MS=15000
CAIRN_TEST_MYSQL_PORT=13309
CAIRN_TEST_DATABASE_URL=mysql://cairn_test:cairn_test_only@localhost:13309/cairn_test

# Proto storage defaults to the Docker-persisted filesystem driver. Set driver to s3 to use object storage.
PROTO_STORAGE_DRIVER=fs
PROTO_STORAGE_FS_BASE=/app/data/protos
PROTO_STORAGE_S3_ENDPOINT=
PROTO_STORAGE_S3_REGION=
PROTO_STORAGE_S3_BUCKET=
PROTO_STORAGE_S3_ACCESS_KEY_ID=
PROTO_STORAGE_S3_SECRET_ACCESS_KEY=
# Optional CA download. Both URL and expected SHA-256 are required together.
CA_CERT_URL=
CA_CERT_SHA256=
# Optional Adminer host port when enabling the Adminer service in docker-compose.yml.
ADMINER_PORT=8888
