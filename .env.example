# Docker Compose MySQL credentials. Replace placeholders for local use.
MYSQL_DATABASE=service_graph
MYSQL_USER=service_graph
MYSQL_PASSWORD=replace-me
MYSQL_ROOT_PASSWORD=replace-me
MYSQL_PORT=3308
CAIRN_TEST_MYSQL_PORT=13306
CAIRN_TEST_DATABASE_URL=mysql://cairn_test:cairn_test_only@localhost:13306/cairn_test

# Host-run Nuxt and Drizzle CLI use localhost. Compose overrides the host to "mysql".
DATABASE_URL=mysql://service_graph:replace-me@localhost:3308/service_graph
OTEL_COLLECTOR_URL=http://host.docker.internal:4318
PROJECT_ID=local
PORT=3003
OUTBOUND_REQUEST_TIMEOUT_MS=10000
TELEMETRY_QUIET_MS=1500
TELEMETRY_MAX_WAIT_MS=10000
CAIRN_TEST_MYSQL_PORT=13306
CAIRN_TEST_DATABASE_URL=mysql://cairn_test:cairn_test_only@localhost:13306/cairn_test
